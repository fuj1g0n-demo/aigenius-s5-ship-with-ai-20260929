---
// Feedback / questions widget — the one interactive, code-bearing feature
// on the site. Client-side only (works on static GitHub Pages, no backend).
//
// The intentionally outdated `marked` renderer remains for the separate
// Dependabot remediation step.
import { FEEDBACK_LIMITS } from '../lib/feedback.js';
---
<section class="card" id="feedback-widget">
  <h2>Questions &amp; feedback</h2>
  <p>Leave a question or comment about this session — it renders below, right in your browser.</p>
  <form id="feedback-form">
    <div class="field">
      <label for="feedback-topic">Topic</label>
      <input id="feedback-topic" name="topic" type="text" placeholder="Code review, security, deployment…" maxlength={FEEDBACK_LIMITS.topic} required />
    </div>
    <div class="field">
      <label for="feedback-name">Name</label>
      <input id="feedback-name" name="name" type="text" placeholder="Ada" maxlength={FEEDBACK_LIMITS.name} />
    </div>
    <div class="field">
      <label for="feedback-message">Message (Markdown supported)</label>
      <textarea id="feedback-message" name="message" rows="3" placeholder="What did you think?" maxlength={FEEDBACK_LIMITS.message} required></textarea>
    </div>
    <button type="submit">Submit</button>
    <p id="feedback-error" role="alert" hidden></p>
  </form>
  <div id="feedback-list" aria-live="polite"></div>
</section>

<style>
  #feedback-widget .field { margin-bottom: 0.8rem; }
  #feedback-widget label { display: block; font-size: 0.85rem; margin-bottom: 0.3rem; color: var(--muted); }
  #feedback-widget input,
  #feedback-widget textarea {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(11, 27, 35, 0.6);
    color: var(--fg);
    font: inherit;
  }
  #feedback-widget input:focus,
  #feedback-widget textarea:focus {
    outline: none;
    border-color: var(--teal);
  }
  #feedback-widget button {
    background: var(--gradient);
    color: #0b1b23;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 0.55rem 1.3rem;
    cursor: pointer;
  }
  #feedback-widget button:hover { opacity: 0.9; }
  #feedback-list { margin-top: 1.2rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .feedback-item {
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
  }
  .feedback-item .meta { font-size: 0.8rem; color: var(--muted); }
</style>

<script>
  // The intentionally outdated renderer is genuinely used here. Rendering
  // untrusted Markdown without sanitising its HTML is a separate optional beat.
  import * as markedModule from 'marked';
  import { FeedbackValidationError, loadSubmissions, saveSubmission } from '../lib/feedback.js';
  import { FEEDBACK_ANALYTICS_TOKEN } from '../lib/analytics-config.js';

  const renderMarkdown =
    Reflect.get(markedModule, 'marked') ?? Reflect.get(markedModule, 'default');

  // Demo-only: would normally authenticate a feedback-analytics beacon.
  // FEEDBACK_ANALYTICS_TOKEN is a fake placeholder — see analytics-config.js.
  console.debug('feedback widget ready', FEEDBACK_ANALYTICS_TOKEN.slice(0, 4));

  const form = document.getElementById('feedback-form');
  const list = document.getElementById('feedback-list');
  const errorMessage = document.getElementById('feedback-error');

  function render() {
    const submissions = loadSubmissions();
    list.innerHTML = submissions
      .slice()
      .reverse()
      .map((s) => {
        const html = renderMarkdown(s.message || '');
        const who = s.name || 'Anonymous';
        const topic = s.topic
          ? `${String(s.topic).replace(/[&<>"']/g, (character) => ({
              '&': '&amp;',
              '<': '&lt;',
              '>': '&gt;',
              '"': '&quot;',
              "'": '&#39;',
            })[character])} · `
          : '';
        const when = new Date(s.submittedAt).toLocaleString();
        return `<div class="feedback-item"><div class="meta">${topic}${who} · ${when}</div>${html}</div>`;
      })
      .join('');
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const topic = data.get('topic');
    const name = data.get('name');
    const message = data.get('message');
    errorMessage.hidden = true;
    errorMessage.textContent = '';
    try {
      saveSubmission(name, message, topic);
    } catch (error) {
      errorMessage.textContent = error instanceof FeedbackValidationError
        ? error.message
        : 'Unable to save feedback. Browser storage may be full or unavailable. Please try again.';
      errorMessage.hidden = false;
      return;
    }
    form.reset();
    render();
  });

  render();
</script>
